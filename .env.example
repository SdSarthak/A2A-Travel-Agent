# Copy this file to .env and adjust as needed. Every value is optional -
# the defaults shown here are what the code uses when the variable is unset.

# --- Optional: live web results for activity recommendations ------------------
# Without a key the search agent uses its curated recommendation database.
# Get a key at https://brave.com/search/api/
BRAVE_API_KEY=your_brave_search_api_key_here
BRAVE_SEARCH_URL=https://api.search.brave.com/res/v1/web/search
BRAVE_RESULT_COUNT=6

# --- Agent ports and URLs -----------------------------------------------------
AGENT_HOST=0.0.0.0
CLIENT_HOST=localhost
WEATHER_AGENT_PORT=8001
SEARCH_AGENT_PORT=8002
LLM_AGENT_PORT=5001
# Override these to point the planner at remotely hosted agents
# WEATHER_AGENT_URL=http://localhost:8001
# SEARCH_AGENT_URL=http://localhost:8002
# LLM_AGENT_URL=http://localhost:5001

# --- Local LLM (Ollama) -------------------------------------------------------
OLLAMA_MODEL=llama3.2:latest
OLLAMA_BASE_URL=http://localhost:11434

# --- Trip defaults ------------------------------------------------------------
DEFAULT_DESTINATION=Paris
DEFAULT_TRAVEL_DATES=June 21-25
DEFAULT_FORECAST_DAYS=7

# --- Units: fahrenheit|celsius, mph|kmh|ms|kn, inch|mm -------------------------
TEMPERATURE_UNIT=fahrenheit
WIND_SPEED_UNIT=mph
PRECIPITATION_UNIT=inch

# --- HTTP / logging -----------------------------------------------------------
REQUEST_TIMEOUT=10
GEOCODING_TIMEOUT=5
USER_AGENT=a2a-travel-agent/2.1
LOG_LEVEL=INFO
